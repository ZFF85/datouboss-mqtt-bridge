# Copy to .env and replace the adapter path and broker address.
# Use the stable /dev/serial/by-id path for the INVERTER adapter.
SERIAL_DEVICE=/dev/serial/by-id/REPLACE_WITH_INVERTER_ADAPTER
MQTT_HOST=mqtt.example.com
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=datouboss-mqtt-bridge
MQTT_BASE_TOPIC=inverter_rs232

# Polling intervals and serial timing, in seconds.
POLL_INTERVAL=1
SLOW_POLL_INTERVAL=30
SERIAL_TIMEOUT=3
COMMAND_DELAY=0.3
LOG_LEVEL=INFO

# Home Assistant discovery (device name is optional).
HA_DISCOVERY_PREFIX=homeassistant
HA_DEVICE_NAME=Datouboss DT4862S

# Optional image override for compose.image.yaml, for example a release or digest.
# INVERTER_IMAGE=ghcr.io/zff85/datouboss-mqtt-bridge:latest
